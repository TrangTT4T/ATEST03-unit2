# Copy this file to .env and fill in the values. .env is in .gitignore: it never goes to GitHub.
# The Swag Labs demo accounts are listed on its login page: https://www.saucedemo.com
# The first two and the password are needed; the others only to run the suite as that user (--account).
SWAG_USERNAME=
SWAG_LOCKED_OUT_USERNAME=
SWAG_PROBLEM_USERNAME=
SWAG_PERFORMANCE_GLITCH_USERNAME=
SWAG_ERROR_USERNAME=
SWAG_VISUAL_USERNAME=
SWAG_PASSWORD=
