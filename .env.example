# Copy this file to .env and fill in the values. .env is in .gitignore: it never goes to GitHub.

# Real customer account, only for: pytest -m auth
SAUCE_EMAIL=
SAUCE_PASSWORD=

# Fake accounts for the login and registration tests (pytest -m "manual or data_creating")
TEST_PASSWORD=
WRONG_PASSWORD=
UNKNOWN_USER_EMAIL=
MALFORMED_EMAIL=
NEW_CUSTOMER_FIRST_NAME=
NEW_CUSTOMER_LAST_NAME=
# {unique} becomes a new id every run, e.g. pw.{unique}@example.com
NEW_CUSTOMER_EMAIL=
